# ============================================
# 企业级多Agent知识库助手 - 环境变量配置
# ============================================

# ============================================
# 数据库配置
# ============================================
DATABASE_TYPE=mysql
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=personal_agent
DATABASE_USER=root
DATABASE_PASSWORD=your_password_here

# ============================================
# JWT配置（必须配置，不能使用默认值）
# ============================================
# 生成强随机密钥的方法：
# Python: import secrets; print(secrets.token_urlsafe(32))
# OpenSSL: openssl rand -base64 32
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_KEY_AT_LEAST_32_CHARACTERS

# ============================================
# CSRF保护配置（必须配置）
# ============================================
# 生成强随机密钥的方法：
# Python: import secrets; print(secrets.token_urlsafe(32))
# OpenSSL: openssl rand -base64 32
CSRF_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_KEY_AT_LEAST_32_CHARACTERS

# ============================================
# OpenAI配置
# ============================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# ============================================
# 智谱AI配置（可选）
# ============================================
ZHIPUAI_API_KEY=your_zhipuai_api_key_here

# ============================================
# 工具API密钥（可选）
# ============================================
# 天气API密钥（OpenWeatherMap）
WEATHER_API_KEY=your_weather_api_key_here

# 搜索API密钥（SerpAPI）
SEARCH_API_KEY=your_search_api_key_here

# ============================================
# 文件上传配置
# ============================================
FILE_UPLOAD_DIR=./uploads
FILE_MAX_SIZE_MB=50

# ============================================
# Redis配置（可选）
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# 向量数据库配置（可选）
# ============================================
# Chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Pinecone
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-west1-gcp

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# ============================================
# 应用配置
# ============================================
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ============================================
# 安全配置
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# 监控配置（可选）
# ============================================
SENTRY_DSN=
LANGSMITH_API_KEY=
